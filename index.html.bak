<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>資安百萬大挑戰 - 現場互動系統</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white min-h-screen p-4 sm:p-6">
    <div class="max-w-4xl mx-auto">
        <header class="text-center mb-6">
            <h1 class="text-3xl font-bold text-yellow-400">🏆 資安百萬大挑戰</h1>
            <p class="text-slate-400">總獎金新台幣 100,000 元整｜殘酷生存淘汰賽</p>
        </header>

        <!-- 1. 登入畫面區 -->
        <div id="login-section" class="bg-slate-800 p-6 rounded-xl shadow-lg border border-slate-700 max-w-md mx-auto">
            <h2 class="text-xl font-semibold mb-4 text-center text-cyan-400">參加者手機登入</h2>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm text-slate-300 mb-1">您的姓名 / 單位：</label>
                    <input type="text" id="player-name-input" placeholder="例如：資安小達人" class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-lg focus:outline-none focus:border-cyan-500">
                </div>
                <button onclick="joinGame()" class="w-full py-2 bg-cyan-600 hover:bg-cyan-500 font-bold rounded-lg transition">進入挑戰大廳</button>
            </div>
            <div class="mt-4 text-xs text-slate-400 text-center">目前已登入人數：<span id="login-count" class="text-green-400 font-bold">0</span> / 30 人</div>
            <div class="mt-6 border-t border-slate-700 pt-4 text-center">
                <button onclick="startHostMode()" class="px-4 py-1.5 bg-yellow-600 hover:bg-yellow-500 text-xs font-bold rounded transition">切換為主控台 / 開始遊戲</button>
            </div>
        </div>

        <!-- 2. 主遊戲與答題大廳 -->
        <div id="game-section" class="hidden space-y-6">
            <!-- 狀態看板 -->
            <div class="bg-slate-800 p-6 rounded-xl shadow-lg border border-slate-700 flex flex-col sm:flex-row justify-between items-center gap-4">
                <div>
                    <h2 class="text-xl font-semibold">存活人數：<span id="alive-count" class="text-green-400 font-bold">0</span> 人</h2>
                    <p class="text-xs text-slate-400 mt-1">當前回合：第 <span id="current-round">1</span> 題</p>
                </div>
                <div id="timer-box" class="text-2xl font-bold text-red-400 bg-slate-900 px-6 py-2 rounded-lg border border-red-500/30 hidden">
                    倒數：<span id="time-left">10</span>秒
                </div>
                <div id="host-controls">
                    <button onclick="nextQuestion()" id="next-btn" class="px-6 py-2 bg-green-600 hover:bg-green-500 font-bold rounded-lg transition shadow">發布下一題</button>
                </div>
            </div>

            <!-- 題目與作答區 -->
            <div id="question-card" class="bg-slate-800 p-6 rounded-xl shadow-lg border border-slate-700 hidden">
                <h3 id="question-title" class="text-xl font-bold mb-4 text-yellow-300">題目載入中...</h3>
                <div id="options-list" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <!-- 動態選項 -->
                </div>
            </div>

            <!-- 手機作答回饋區 -->
            <div id="player-feedback" class="bg-slate-800 p-6 rounded-xl shadow-lg border border-slate-700 text-center hidden">
                <h3 id="feedback-text" class="text-2xl font-bold mb-2">請等待主持人出題...</h3>
                <p id="feedback-sub" class="text-slate-400">作答後將在此顯示結果</p>
            </div>

            <!-- 存活名單牆 -->
            <div class="bg-slate-800 p-6 rounded-xl shadow-lg border border-slate-700">
                <h3 class="text-sm font-semibold text-slate-400 mb-3">當前存活選手名單：</h3>
                <div id="player-grid" class="flex flex-wrap gap-2 max-h-48 overflow-y-auto p-3 bg-slate-900 rounded-lg border border-slate-800">
                    <!-- 動態填入名字 -->
                </div>
            </div>
        </div>

        <!-- 3. 結算頒獎台 -->
        <div id="podium-area" class="hidden bg-slate-800 p-8 rounded-xl shadow-xl border border-yellow-500 mt-6 text-center">
            <h2 class="text-3xl font-bold text-yellow-400 mb-2">🎉 競賽圓滿結束！獎金分配出爐</h2>
            <p class="text-slate-300 mb-6">總獎金 NT$ 100,000 依答對表現與名次比例分配</p>
            <div id="ranking-list" class="space-y-4 max-w-xl mx-auto text-left"></div>
            <button onclick="location.reload()" class="mt-8 px-6 py-2 bg-slate-700 hover:bg-slate-600 font-bold rounded-lg transition">重新開始競賽</button>
        </div>
    </div>

    <script>
        const questions = [
            {
                q: "1. 下列哪一種密碼設定方式最不容易被駭客破解？",
                options: ["A. 自己的生日加英文名字", "B. 連續數字 12345678", "C. 大小寫英文、數字與特殊符號交錯的長密碼", "D. 公司名稱加分機號"],
                answer: 2
            },
            {
                q: "2. 同事突然透過即時通訊傳來一個未曾討論過的抽獎活動網址，您應該？",
                options: ["A. 馬上點進去搶頭香", "B. 先轉傳給其他同事一起抽", "C. 當面或電話向該同事查證是否帳號被盜", "D. 輸入個資領取獎品"],
                answer: 2
            },
            {
                q: "3. 上班時發現電腦畫面突然被上鎖，並跳出比特幣勒索畫面，第一步應？",
                options: ["A. 拍照發群組討拍", "B. 立刻拔掉網路線並通報資安人員", "C. 上網搜尋解密軟體自己處理", "D. 直接關機重開機"],
                answer: 1
            },
            {
                q: "4. 收到署名長官要求緊急匯款的 Line 訊息，最安全的處置方式是？",
                options: ["A. 依照指示立刻轉帳", "B. 先匯小額測試", "C. 透過公司內部電話或當面向長官本人求證", "D. 回傳貼圖表示收到"],
                answer: 2
            },
            {
                q: "5. 離開座位離開超過5分鐘以上，最符合資安規範的動作是？",
                options: ["A. 保持解鎖狀態方便回來做事", "B. 螢幕貼上便利貼提醒", "C. 使用快捷鍵鎖定螢幕 (Win+L)", "D. 請隔壁同事幫忙盯著"],
                answer: 2
            }
        ];

        let players = [];
        let currentPlayer = null;
        let currentQuestionIdx = -1;
        let timer = null;
        let timeLeft = 10;
        let answeredCurrent = false;

        function joinGame() {
            const nameInput = document.getElementById('player-name-input');
            const name = nameInput.value.trim();
            if(!name) { alert('請輸入您的名字！'); return; }
            if(players.some(p => p.name === name)) { alert('此名字已經被使用囉！'); return; }

            currentPlayer = { name, alive: true, score: 0 };
            players.push(currentPlayer);
            document.getElementById('login-count').innerText = players.length;
            
            document.getElementById('login-section').classList.add('hidden');
            document.getElementById('game-section').classList.remove('hidden');
            document.getElementById('host-controls').classList.add('hidden');
            updatePlayerGrid();
            
            document.getElementById('player-feedback').classList.remove('hidden');
            document.getElementById('feedback-text').innerText = `歡迎加入，${name}！`;
            document.getElementById('feedback-sub').innerText = "請等待主持人發布題目...";
        }

        function startHostMode() {
            if(players.length === 0) {
                players = [
                    { name: "資安小王", alive: true, score: 0 },
                    { name: "資訊處小李", alive: true, score: 0 },
                    { name: "政風室小張", alive: true, score: 0 }
                ];
            }
            document.getElementById('login-section').classList.add('hidden');
            document.getElementById('game-section').classList.remove('hidden');
            document.getElementById('host-controls').classList.remove('hidden');
            updatePlayerGrid();
        }

        function updatePlayerGrid() {
            const grid = document.getElementById('player-grid');
            grid.innerHTML = '';
            let aliveCount = 0;
            players.forEach(p => {
                if(p.alive) aliveCount++;
                const badge = document.createElement('div');
                badge.className = `px-3 py-1 rounded-full text-xs font-bold transition ${p.alive ? 'bg-green-900 text-green-300 border border-green-600' : 'bg-red-900/50 text-red-400 line-through opacity-50'}`;
                badge.innerText = p.name;
                grid.appendChild(badge);
            });
            document.getElementById('alive-count').innerText = aliveCount;
        }

        function nextQuestion() {
            currentQuestionIdx++;
            if(currentQuestionIdx >= questions.length) {
                endGame();
                return;
            }

            document.getElementById('current-round').innerText = currentQuestionIdx + 1;
            const qData = questions[currentQuestionIdx];
            
            document.getElementById('question-card').classList.remove('hidden');
            document.getElementById('player-feedback').classList.add('hidden');
            document.getElementById('question-title').innerText = qData.q;
            
            const optionsList = document.getElementById('options-list');
            optionsList.innerHTML = '';
            
            qData.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "p-3 bg-slate-700 hover:bg-cyan-600 text-left rounded-lg transition font-medium text-sm";
                btn.innerText = opt;
                btn.onclick = () => submitAnswer(idx);
                optionsList.appendChild(btn);
            });

            timeLeft = 10;
            answeredCurrent = false;
            document.getElementById('timer-box').classList.remove('hidden');
            document.getElementById('time-left').innerText = timeLeft;
            
            timer = setInterval(() => {
                timeLeft--;
                document.getElementById('time-left').innerText = timeLeft;
                if(timeLeft <= 0) {
                    clearInterval(timer);
                    evaluateRound(qData.answer);
                }
            }, 1000);
        }

        function submitAnswer(selectedIdx) {
            if(answeredCurrent || !currentPlayer || !currentPlayer.alive) return;
            answeredCurrent = true;
            
            const qData = questions[currentQuestionIdx];
            const isCorrect = (selectedIdx === qData.answer);
            
            if(isCorrect) {
                currentPlayer.score += 10;
                document.getElementById('question-card').classList.add('hidden');
                document.getElementById('player-feedback').classList.remove('hidden');
                document.getElementById('feedback-text').innerText = "✅ 回答正確！";
                document.getElementById('feedback-sub').innerText = "請等待下一題或結算...";
            } else {
                currentPlayer.alive = false;
                document.getElementById('question-card').classList.add('hidden');
                document.getElementById('player-feedback').classList.remove('hidden');
                document.getElementById('feedback-text').innerText = "❌ 回答錯誤！您已被淘汰";
                document.getElementById('feedback-sub').innerText = "感謝您的參與，請觀看後續對決";
            }
        }

        function evaluateRound(correctAnswer) {
            clearInterval(timer);
            document.getElementById('timer-box').classList.add('hidden');
            document.getElementById('question-card').classList.add('hidden');
            
            players.forEach(p => {
                if(p.alive) {
                    if(p !== currentPlayer && Math.random() > 0.7) {
                        p.alive = false;
                    } else if(p !== currentPlayer) {
                        p.score += 10;
                    }
                }
            });

            updatePlayerGrid();
            
            const aliveRemaining = players.filter(p => p.alive).length;
            document.getElementById('player-feedback').classList.remove('hidden');
            document.getElementById('feedback-text').innerText = `⏰ 本題結束！正確答案是選項 ${(correctAnswer + 1)}`;
            document.getElementById('feedback-sub').innerText = `當前場上存活人數：${aliveRemaining} 人`;

            if(aliveRemaining <= 1 || currentQuestionIdx >= questions.length - 1) {
                setTimeout(endGame, 3000);
            }
        }

        function endGame() {
            document.getElementById('game-section').classList.add('hidden');
            document.getElementById('podium-area').classList.remove('hidden');
            
            players.sort((a, b) => b.score - a.score);
            const top3 = players.slice(0, 3);
            
            const rankingList = document.getElementById('ranking-list');
            rankingList.innerHTML = '';
            
            const prizePool = 100000;
            const ratios = [0.5, 0.3, 0.2];
            const medals = ["🥇 冠軍", "🥈 亞軍", "🥉 季軍"];
            
            top3.forEach((p, idx) => {
                const amount = prizePool * ratios[idx];
                const div = document.createElement('div');
                div.className = "flex justify-between items-center p-4 bg-slate-900 rounded-lg border border-slate-700";
                div.innerHTML = `
                    <div>
                        <span class="text-xl font-bold text-yellow-400 mr-3">${medals[idx]}</span>
                        <span class="text-lg font-semibold">${p.name}</span>
                        <span class="text-xs text-slate-400 block mt-1">得分：${p.score} 分</span>
                    </div>
                    <div class="text-right">
                        <span class="text-xl font-bold text-green-400">NT$ ${amount.toLocaleString()}</span>
                        <span class="text-xs text-slate-400 block">佔比 ${(ratios[idx]*100)}%</span>
                    </div>
                `;
                rankingList.appendChild(div);
            });
        }
    </script>
</body>
</html>
